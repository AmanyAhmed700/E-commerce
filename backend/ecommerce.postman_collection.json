{
  "info": {
    "name": "Ecommerce API",
    "_postman_id": "12345678-aaaa-bbbb-cccc-1234567890ab",
    "description": "Full Collection for testing Ecommerce API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/auth/register", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"123456\"\n}" },
        "url": { "raw": "http://localhost:5000/api/auth/login", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "Users - Get All (Admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": { "raw": "http://localhost:5000/api/users", "host": ["localhost"], "port": "5000", "path": ["api", "users"] }
      }
    },
    {
      "name": "Products - Get All",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:5000/api/products", "host": ["localhost"], "port": "5000", "path": ["api", "products"] }
      }
    },
    {
      "name": "Products - Create (Admin)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Laptop\",\n  \"price\": 1200,\n  \"description\": \"Gaming laptop\"\n}" },
        "url": { "raw": "http://localhost:5000/api/products", "host": ["localhost"], "port": "5000", "path": ["api", "products"] }
      }
    },
    {
      "name": "Products - Update (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Laptop\",\n  \"price\": 1500\n}" },
        "url": { "raw": "http://localhost:5000/api/products/{{productId}}", "host": ["localhost"], "port": "5000", "path": ["api", "products", "{{productId}}"] }
      }
    },
    {
      "name": "Products - Delete (Admin)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": { "raw": "http://localhost:5000/api/products/{{productId}}", "host": ["localhost"], "port": "5000", "path": ["api", "products", "{{productId}}"] }
      }
    },
    {
      "name": "Cart - Add Item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}" },
        "url": { "raw": "http://localhost:5000/api/cart", "host": ["localhost"], "port": "5000", "path": ["api", "cart"] }
      }
    },
    {
      "name": "Cart - Get Items",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
        "url": { "raw": "http://localhost:5000/api/cart", "host": ["localhost"], "port": "5000", "path": ["api", "cart"] }
      }
    },
    {
      "name": "Cart - Remove Item",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
        "url": { "raw": "http://localhost:5000/api/cart/{{itemId}}", "host": ["localhost"], "port": "5000", "path": ["api", "cart", "{{itemId}}"] }
      }
    },
    {
      "name": "Orders - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{user_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"address\": \"123 Street\"\n}" },
        "url": { "raw": "http://localhost:5000/api/orders", "host": ["localhost"], "port": "5000", "path": ["api", "orders"] }
      }
    },
    {
      "name": "Orders - Get All (Admin)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
        "url": { "raw": "http://localhost:5000/api/orders", "host": ["localhost"], "port": "5000", "path": ["api", "orders"] }
      }
    },
    {
      "name": "Orders - Get My Orders",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{user_token}}" }],
        "url": { "raw": "http://localhost:5000/api/orders/my", "host": ["localhost"], "port": "5000", "path": ["api", "orders", "my"] }
      }
    },
    {
      "name": "Orders - Update Status (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{admin_token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"shipped\"\n}" },
        "url": { "raw": "http://localhost:5000/api/orders/{{orderId}}", "host": ["localhost"], "port": "5000", "path": ["api", "orders", "{{orderId}}"] }
      }
    },
    {
      "name": "Invalid Route Test",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:5000/api/not-found", "host": ["localhost"], "port": "5000", "path": ["api", "not-found"] }
      }
    }
  ]
}
